# =====================================================================
# Nova — AI-Powered Meeting Follow-Up System Environment Configuration
# =====================================================================
# IMPORTANT: Copy this file to '.env' in the project root or backend folder
# and fill in your actual credentials. Never commit your '.env' to git!

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Configurable Gemini Model (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash)
# If gemini-2.5-flash is not available in your region/tier, use gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas Persistent Database URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# If left blank, Nova falls back to local persistent JSON storage automatically.
MONGODB_URI=
DATABASE_NAME=nova

# Agent Workflow & Human-in-the-Loop Threshold (0.0 to 1.0)
# Tasks with confidence score below this threshold are routed to Human Review queue
CONFIDENCE_THRESHOLD=0.70

# Max Audio/Video Upload Size (in Megabytes)
MAX_UPLOAD_SIZE_MB=200

# Backend & Frontend Server URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

